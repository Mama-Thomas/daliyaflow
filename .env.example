# DaliyaFlow Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# App
ENVIRONMENT=development
SECRET_KEY=generate-a-long-random-string-here
JWT_SECRET_KEY=generate-a-long-random-string-here
JWT_REFRESH_SECRET=generate-another-long-random-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAGIC_LINK_EXPIRE_MINUTES=15

# Database
DATABASE_URL=postgresql+asyncpg://daliya:devpassword@postgres:5432/daliyaflow_dev

# Redis
REDIS_URL=redis://redis:6379/0

# AWS (for S3 audio storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2
AUDIO_BUCKET=daliyaflow-audio-dev

# AI APIs
ANTHROPIC_API_KEY=your_anthropic_api_key   # Used for handoff generation and risk flags
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your_openai_api_key         # Used for Whisper voice transcription (~$0.006/min)
OPENAI_WHISPER_MODEL=whisper-1

# Email (AWS SES)
EMAIL_PROVIDER=console                     # one of: console, ses
EMAIL_FROM_ADDRESS=no-reply@daliyaflow.com
EMAIL_FROM_NAME=DaliyaFlow
SEND_EMAILS=false                          # Set to true in production
APP_BASE_URL=http://localhost:3000

# Observability
SENTRY_DSN=                                # Leave blank to disable Sentry

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production-only allowlist. When ENVIRONMENT=production AND ALLOWED_ORIGINS
# is set, it replaces CORS_ORIGINS for the live deploy. Leave blank for dev.
ALLOWED_ORIGINS=

# Sessions
SESSION_TIMEOUT_MINUTES=30
SESSION_TIMEOUT_MINUTES_CAREGIVER=60
SESSION_TIMEOUT_WARNING_MINUTES=5

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
